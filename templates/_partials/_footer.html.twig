<footer class="site-footer" aria-labelledby="footer-title">
    {% set headLogoSection = getSectionByName('head_logo') %}
    {% set logoMedia = headLogoSection ? headLogoSection.media.first : null %}
    <div class="site-footer__top">
        <a class="site-footer__brand" href="{{ path('app_home') }}" aria-label="Pepperjam — back to home">
            {% if logoMedia %}
                <img class="site-footer__brand-logo" src="{{ asset(logoMedia.path ~ logoMedia.filename) }}" alt="">
                <span class="visually-hidden" id="footer-title">Pepperjam</span>
            {% else %}
                <span class="site-footer__brand-mark" aria-hidden="true">P!</span>
                <span id="footer-title">PEPPERJAM<span class="site-footer__dot">.</span></span>
            {% endif %}
        </a>

        <p class="site-footer__tagline">Spice up<br><span>Your game audio</span></p>

        <nav class="site-footer__nav" aria-label="Footer navigation">
            <a href="{{ path('app_home') }}#activities">Activities</a>
            <a href="{{ path('app_home') }}#collective">About</a>
            <a href="{{ path('app_home') }}#team">The team</a>
            <a href="{{ path('app_home') }}#resound">Resound</a>
            <a href="{{ path('app_home') }}#softwares">Our tools</a>
        </nav>

        <div class="site-footer__contact">
            <span class="site-footer__eyebrow">Got a project?</span>
            <a class="site-footer__email" href="{{path('app_contact')}}">contact us<span aria-hidden="true">↗</span></a>
{#            <span class="site-footer__placeholder">London · Paris · Everywhere</span>#}
        </div>
    </div>

    <div class="site-footer__bottom">
        <span>© {{ 'now'|date('Y') }} Pepperjam Studio</span>
{#        <span class="site-footer__note">Independent sound for worlds worth getting lost in.</span>#}
        <nav class="site-footer__legal" aria-label="Legal information">
            <a href="{{ path('app_legal_notice') }}">Legal notice</a>
            <a href="{{ path('app_cookie_policy') }}">Cookies</a>
        </nav>
        <a href="{{ path('app_home') }}#showreel" class="site-footer__back-top">Back to top <span aria-hidden="true">↑</span></a>
    </div>
</footer>
