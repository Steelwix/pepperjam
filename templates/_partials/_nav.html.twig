

<header class="d-flex justify-content-center mt-3">
    <nav class="navbar">
        {% set currentRoute = app.request.attributes.get('_route') %}
        {% set currentRouteParams = app.request.attributes.get('_route_params')|default({}) %}

        {% if app.user and is_granted('ROLE_ADMIN') and editing is defined and editing == false %}
            <a
                class="nav-link fw-bold"
                href="{{ path(currentRoute, currentRouteParams|merge({ editing: true })) }}"
            >
                EDIT
            </a>
        {% endif %}

        {% if app.user and is_granted('ROLE_ADMIN') and editing is defined and editing == true %}
            <a
                class="nav-link fw-bold"
                href="{{ path(currentRoute, currentRouteParams|merge({ editing: false })) }}"
            >
                CONFIRM CHANGES
            </a>
        {% endif %}
    </nav>
</header>


