{% extends 'base.html.twig' %}

{% block title %}Create account · Pepperjam{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/auth-page.css') }}">
{% endblock %}

{% block body %}
    <main class="auth-page">
        <section class="auth-card auth-card--register" aria-labelledby="auth-title">
            <div class="auth-card__intro">
                <span class="auth-kicker">STUDIO ACCESS</span>
                <h1 id="auth-title">Join the<br><em>crew.</em></h1>
                <p>Create your account with the invitation code you received. Access is granted after approval.</p>
                <span class="auth-stamp" aria-hidden="true">PJ<br>★</span>
            </div>

            <div class="auth-card__content">
                {{ form_errors(registrationForm) }}
                {{ form_start(registrationForm, { attr: { class: 'auth-form' } }) }}
                    <div class="auth-field">
                        {{ form_label(registrationForm.username) }}
                        {{ form_widget(registrationForm.username, { attr: { class: 'form-control', autocomplete: 'username', placeholder: 'Choose a username' } }) }}
                        {{ form_errors(registrationForm.username) }}
                    </div>

                    <div class="auth-field">
                        {{ form_label(registrationForm.pepperjamCode) }}
                        {{ form_widget(registrationForm.pepperjamCode, { attr: { class: 'form-control', placeholder: 'Your invitation code' } }) }}
                        {{ form_errors(registrationForm.pepperjamCode) }}
                    </div>

                    <div class="auth-field">
                        {{ form_label(registrationForm.plainPassword, 'Password') }}
                        {{ form_widget(registrationForm.plainPassword, { attr: { class: 'form-control', autocomplete: 'new-password', placeholder: 'At least 6 characters' } }) }}
                        {{ form_errors(registrationForm.plainPassword) }}
                    </div>

                    <button class="auth-button" type="submit">Request access <span aria-hidden="true">↗</span></button>
                {{ form_end(registrationForm) }}

                <p class="auth-switch">Already have an account? <a href="{{ path('app_login') }}">Sign in</a></p>
            </div>
        </section>
    </main>
{% endblock %}
