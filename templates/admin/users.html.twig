{% extends 'base.html.twig' %}

{% block title %}Pending accounts · {{ parent() }}{% endblock %}

{% block body %}
    <main class="container py-5">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
            <div>
                <p class="text-warning text-uppercase fw-bold small mb-2">Admin</p>
                <h1 class="h2 mb-0">Pending accounts</h1>
            </div>
            <a href="{{ path('app_home', { editing: true }) }}" class="btn btn-outline-light">Back to site</a>
        </div>

        {% if pendingUsers is empty %}
            <div class="border border-secondary p-4 text-secondary">No accounts are waiting for approval.</div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-dark table-striped align-middle">
                    <thead>
                    <tr><th>Username</th><th class="text-end">Action</th></tr>
                    </thead>
                    <tbody>
                    {% for user in pendingUsers %}
                        <tr>
                            <td>{{ user.username }}</td>
                            <td class="text-end">
                                <form method="post" action="{{ path('app_admin_users_enable', { id: user.id }) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('enable-user-' ~ user.id) }}">
                                    <button type="submit" class="btn btn-warning btn-sm fw-bold">Activate account</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </main>
{% endblock %}
