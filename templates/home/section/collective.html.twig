<turbo-stream action="replace" target="{{ spot }}">
    <template>
        <section id="{{ spot }}" class="container py-5">
            <div class="row justify-content-center">
                <div class="col-12 col-xl-9">
                    <div class="card bg-dark border-secondary shadow-lg overflow-hidden">
                        <div class="card-body p-4 p-md-5">

                            <div class="d-flex align-items-center gap-3 mb-4">
                                <div
                                    class="d-flex align-items-center justify-content-center rounded-3 bg-primary bg-opacity-25 text-primary"
                                    style="width: 48px; height: 48px;"
                                >
                                    <i class="bi bi-people fs-4"></i>
                                </div>

                                <div>
                                    <h3 class="mb-1">Modify the collective</h3>
                                    <p class="text-secondary mb-0">
                                        Update the content displayed in your collective section.
                                    </p>
                                </div>
                            </div>

                            {{ form_start(form, {
                                action: path('app_edit_section', {
                                    sectionType: spot
                                }),
                                attr: {
                                    'data-turbo': 'true'
                                }
                            }) }}

                            <div class="row g-4 align-items-start">

                                {# Formulaire #}
                                <div class="col-12 col-lg-5">

                                    <div class="p-4 rounded-4 bg-black bg-opacity-25 border border-secondary border-opacity-50">

                                        <div class="mb-3">
                                            {{ form_label(form.media, 'Media', {
                                                label_attr: {
                                                    class: 'form-label fw-semibold'
                                                }
                                            }) }}

                                            {{ form_widget(form.media, {
                                                attr: {
                                                    class: 'form-control'
                                                }
                                            }) }}

                                            {% if form.media.vars.help is defined %}
                                                <div class="form-text">
                                                    {{ form.media.vars.help }}
                                                </div>
                                            {% endif %}

                                            {{ form_errors(form.media) }}
                                        </div>

                                        <div class="mb-3">
                                            {{ form_label(form.title, 'Title', {
                                                label_attr: {
                                                    class: 'form-label fw-semibold'
                                                }
                                            }) }}

                                            {{ form_widget(form.title, {
                                                attr: {
                                                    class: 'form-control'
                                                }
                                            }) }}

                                            {{ form_errors(form.title) }}
                                        </div>

                                        <div class="mb-3">
                                            {{ form_label(form.content, 'Content', {
                                                label_attr: {
                                                    class: 'form-label fw-semibold'
                                                }
                                            }) }}

                                            {{ form_widget(form.content, {
                                                attr: {
                                                    hidden: true
                                                }
                                            }) }}

                                            <trix-editor input="{{ form.content.vars.id }}"></trix-editor>

                                            {{ form_errors(form.content) }}
                                        </div>

                                        <div class="d-flex justify-content-end">
                                            <button type="submit" class="btn btn-primary px-4">
                                                <i class="bi bi-save me-2"></i>
                                                Save changes
                                            </button>
                                        </div>

                                    </div>

                                </div>

                                {# Aperçu #}
                                <div class="col-12 col-lg-7">

                                    <div class="mb-3">
                                        <h5 class="mb-1">Current media</h5>
                                        <p class="text-secondary small mb-0">
                                            This is the media currently displayed in your collective section.
                                        </p>
                                    </div>

                                    {% if media is defined and media.filename is defined and media.filename is not null %}

                                        {% set ext = media.filename|split('.')|last|lower %}

                                        <div class="rounded-4 overflow-hidden border border-secondary border-opacity-50 bg-black">

                                            {% if ext in ['mp4', 'webm', 'ogg', 'mov'] %}

                                                <video
                                                    class="w-100 d-block"
                                                    controls
                                                    playsinline
                                                    preload="metadata"
                                                >
                                                    <source
                                                        src="{{ asset(media.path ~ media.filename) }}"
                                                        type="video/{{ ext }}"
                                                    >
                                                    Votre navigateur ne supporte pas la vidéo.
                                                </video>

                                            {% elseif ext in ['jpg', 'jpeg', 'png', 'gif', 'webp'] %}

                                                <img
                                                    src="{{ asset(media.path ~ media.filename) }}"
                                                    alt="Current collective media"
                                                    class="img-fluid w-100 d-block"
                                                >

                                            {% else %}

                                                <div class="p-4 text-warning">
                                                    <i class="bi bi-exclamation-triangle me-2"></i>
                                                    Unsupported media format: {{ ext }}
                                                </div>

                                            {% endif %}

                                        </div>

                                        <div class="mt-2 text-secondary small text-truncate">
                                            <i class="bi bi-file-earmark me-1"></i>
                                            {{ media.filename }}
                                        </div>

                                    {% else %}

                                        <div class="d-flex flex-column align-items-center justify-content-center text-center rounded-4 border border-secondary border-opacity-50 bg-black bg-opacity-25 p-5">
                                            <i class="bi bi-image text-secondary fs-1 mb-3"></i>

                                            <h6 class="mb-2">No media yet</h6>

                                            <p class="text-secondary small mb-0">
                                                Upload a file to display your collective media here.
                                            </p>
                                        </div>

                                    {% endif %}

                                </div>

                            </div>

                            {{ form_end(form) }}

                        </div>
                    </div>

                </div>
            </div>
        </section>
    </template>
</turbo-stream>
