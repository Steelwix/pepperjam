


<section class="resound-section cp-block" id="resound">

    <header class="resound-header">
        <p class="resound-eyebrow">// RESOUND //</p>
{#        <h2>Hear it <span>different.</span></h2>#}
{#        <p class="resound-intro">Familiar worlds, remixed with sound.</p>#}
    </header>

    {% set section = getSectionByName('resound') %}
    {% set resounds = getResounds() %}

    {# ADD RESOUND #}
    <a
        href="{{ path('app_edit_section', {'sectionType': 'resound'}) }}"
        class="btn btn-primary edit-display mb-3"
        title="Ajouter un Resound"
    >
        ✎ Add Resound
    </a>

    {% if section is not null and resounds|length > 0 and not editing %}

        <div class="resound-marquee">

            <div class="resound-track {% if resounds|length > 2 %}scrolling{% endif %}">

                {# GROUPE PRINCIPAL #}
                <div class="resound-group">

                    {% for resound in resounds %}

                        {% set media = resound.media %}

                        <article class="resound-card">

                            {# MODIFY RESOUND #}
                            <a
                                href="{{ path('app_edit_section', {
                                    'sectionType': 'resound',
                                    'id': resound.id
                                }) }}"
                                class="btn btn-primary btn-sm edit-display"
                                title="Modifier le Resound"
                            >
                                ✎ Edit
                            </a>

                            <div class="resound-video">

                                {% if media %}
                                    <video controls preload="metadata">
                                        <source
                                            src="{{ asset(media.path ~ media.filename) }}"
                                            type="{{ media.mimeType|default('video/mp4') }}"
                                        >
                                        Votre navigateur ne supporte pas la lecture vidéo.
                                    </video>
                                {% endif %}

                            </div>

                            <div class="resound-info">

{#                                <span class="resound-category">#}
{#                                    Sound redesign#}
{#                                </span>#}

                                <h3>{{ resound.title }}</h3>

                            </div>

                        </article>

                    {% endfor %}

                </div>


                {# COPIE POUR LE SCROLL SEAMLESS #}
                {% if resounds|length > 2 %}

                    <div class="resound-group" aria-hidden="true">

                        {% for resound in resounds %}

                            {% set media = resound.media %}

                            <article class="resound-card">

                                <div class="resound-video">

                                    {% if media %}
                                        <video
                                            controls
                                            preload="metadata"
                                            tabindex="-1"
                                        >
                                            <source
                                                src="{{ asset(media.path ~ media.filename) }}"
                                                type="{{ media.mimeType|default('video/mp4') }}"
                                            >
                                        </video>
                                    {% endif %}

                                </div>

                                <div class="resound-info">

                                    <span class="resound-category">
                                        Sound redesign
                                    </span>

                                    <h3>{{ resound.title }}</h3>

                                </div>

                            </article>

                        {% endfor %}

                    </div>

                {% endif %}

            </div>

        </div>

    {% else %}

        {# TABLEAU D'ADMINISTRATION #}
        <div class="table-responsive">

            <table class="table table-dark table-hover align-middle">

                <thead>
                <tr>
                    <th>Titre</th>
                    <th class="text-end">Actions</th>
                </tr>
                </thead>

                <tbody>

                {% for resound in resounds %}

                    <tr>

                        <td>{{ resound.title }}</td>

                        <td class="text-end text-nowrap">

                            <a
                                href="{{ path('app_edit_section', {
                                    'sectionType': 'resound',
                                    'id': resound.id
                                }) }}"
                                class="btn btn-primary btn-sm"
                            >
                                ✎ Edit
                            </a>

                            <a
                                href="{{ path('app_remove_resound', {
                                    'id': resound.id
                                }) }}"
                                class="btn btn-primary btn-sm"
                            >
                                Delete
                            </a>

                        </td>

                    </tr>

                {% endfor %}

                </tbody>

            </table>

        </div>

    {% endif %}

</section>

<script>
    (() => {
        const bindResoundVideos = () => {
            document.querySelectorAll('#resound .resound-track video:not([data-scroll-pause-bound])')
                .forEach((video) => {
                    const track = video.closest('.resound-track');
                    if (!track) {
                        return;
                    }

                    video.dataset.scrollPauseBound = 'true';

                    const videoContainer = video.closest('.resound-video');

                    videoContainer.addEventListener('pointerenter', () => {
                        track.classList.add('video-hovered');
                    });

                    videoContainer.addEventListener('pointerleave', () => {
                        if (!track.querySelector('.resound-video:hover')) {
                            track.classList.remove('video-hovered');
                        }
                    });

                    const updatePlaybackState = () => {
                        const hasPlayingVideo = [...track.querySelectorAll('.resound-video video')]
                            .some((item) => !item.paused && !item.ended);

                        track.classList.toggle('video-playing', hasPlayingVideo);
                    };

                    video.addEventListener('play', updatePlaybackState);
                    video.addEventListener('pause', updatePlaybackState);
                    video.addEventListener('ended', updatePlaybackState);

                    if (videoContainer.matches(':hover')) {
                        track.classList.add('video-hovered');
                    }
                    updatePlaybackState();
                });
        };

        bindResoundVideos();
        document.addEventListener('turbo:load', bindResoundVideos);
    })();
</script>
