<style>
    .team-section {
        position: relative;
        width: min(1400px, 100%);
        margin: clamp(56px, 9vw, 120px) auto;
        padding: clamp(28px, 5vw, 64px) 0;
        overflow: hidden;
        color: #fff;
        background: #090909;
        border-block: 2px solid var(--color-pop-yellow);
    }

    .team-section::before {
        position: absolute;
        top: -70px;
        right: 5%;
        width: 190px;
        height: 190px;
        content: "";
        pointer-events: none;
        background-image: radial-gradient(var(--color-pop-red) 2px, transparent 2px);
        background-size: 17px 17px;
        opacity: .35;
        transform: rotate(-9deg);
    }

    .team-header {
        position: relative;
        z-index: 1;
        margin: 0 clamp(22px, 6vw, 84px) 34px;
    }
    .team-header { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
    .team-eyebrow { margin: 0 0 12px; color: var(--color-pop-yellow); font-size: 11px; font-weight: 800; letter-spacing: .2em; }
    .team-header h2 { margin: 0; color: #fff; font-size: clamp(34px, 6vw, 68px); font-weight: 950; line-height: .95; letter-spacing: -.06em; text-transform: uppercase; }
    .team-header h2 span { color: var(--color-pop-red); }
    .team-intro { margin: 14px 0 0; color: rgba(255,255,255,.65); font-size: 14px; }

    .team-section > .edit-display {
        position: relative;
        z-index: 1;
        margin: 0 clamp(22px, 6vw, 84px) 12px;
        color: #080808;
        background: var(--color-pop-yellow);
        border: 0;
        border-radius: 0;
        box-shadow: 3px 3px 0 var(--color-pop-red);
        font-size: 12px;
        font-weight: 800;
    }

    .team-marquee {
        position: relative;
        width: 100%;
        overflow: hidden;
        padding: 28px 0;
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
        mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    }
    .team-track { display: flex; width: max-content; }
    .team-track.scrolling { animation: team-scroll 35s linear infinite; }
    .team-track.scrolling:hover { animation-play-state: paused; }
    .team-group { display: flex; flex: 0 0 auto; align-items: stretch; gap: 22px; padding-right: 22px; }

    .team-card {
        position: relative;
        flex: 0 0 280px;
        width: 280px;
        overflow: hidden;
        background: #111;
        border: 1px solid rgba(255,255,255,.14);
        transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
    }
    .team-card:hover { z-index: 1; transform: translateY(-5px); border-color: var(--color-pop-red); box-shadow: 5px 5px 0 var(--color-pop-red); }
    .team-card > .edit-display { position: absolute; z-index: 2; top: 8px; right: 8px; color: #080808; background: var(--color-pop-yellow); border: 0; border-radius: 0; font-size: 11px; font-weight: 800; }
    .team-card-image { width: 100%; aspect-ratio: 4 / 5; overflow: hidden; background: #1b1b1b; }
    .team-card-image img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
    .team-card:hover .team-card-image img { transform: scale(1.04); }
    .team-card-info { padding: 18px; }
    .team-card-role { display: block; margin-bottom: 7px; color: var(--color-pop-yellow); font-size: 10px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
    .team-card-info h3 { margin: 0; color: #fff; font-size: 21px; font-weight: 900; line-height: 1.05; text-transform: uppercase; }

    .team-bio-open { margin-top: 14px; padding: 7px 10px; color: #fff; background: transparent; border: 1px solid rgba(255,255,255,.7); border-radius: 0; font-size: 10px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; }
    .team-bio-open:hover, .team-bio-open:focus-visible { color: #080808; background: var(--color-pop-yellow); border-color: var(--color-pop-yellow); box-shadow: 3px 3px 0 var(--color-pop-red); }

    .team-section .table-responsive { position: relative; z-index: 1; margin: 10px clamp(22px, 6vw, 84px) 0; }
    .team-section .table { --bs-table-bg: #111; --bs-table-color: #fff; --bs-table-border-color: rgba(255,255,255,.16); }
    .team-section .table thead th { color: var(--color-pop-yellow); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; }
    .team-section .table .btn { border-radius: 0; font-size: 11px; font-weight: 800; }

    @keyframes team-scroll { from { transform: translate3d(0,0,0); } to { transform: translate3d(-50%,0,0); } }
    @media (max-width: 768px) {
        .team-section { margin-inline: 0; }
        .team-card { flex-basis: 240px; width: 240px; }
        .team-group { gap: 18px; padding-right: 18px; }
    }
</style>

<section class="team-section cp-block" id="team">

    {% set section = getSectionByName('team') %}
    {% set team = getTeamMembers() %}

    <header class="team-header">
{#        <p class="team-eyebrow">// THE PEOPLE //</p>#}
        <h2>Meet the <span>team</span></h2>
{#        <p class="team-intro">A little talent. A lot of imagination.</p>#}
    </header>

    {# ADD MEMBER #}
    <a
        href="{{ path('app_edit_section', {'sectionType': 'team'}) }}"
        class="btn btn-primary edit-display"
        title="Modifier la section"
    >
        ✎ Add member
    </a>

    {% if section is not null and team|length > 0 and not editing %}

        {% if team|length > 3 %}
            <div class="carousel-control-row">
                <div class="carousel-controls" aria-label="Team carousel controls">
                    <button type="button" data-carousel-speed="-1" aria-label="Move team carousel left">←</button>
                    <button type="button" data-carousel-speed="1" aria-label="Move team carousel right">→</button>
                </div>
            </div>
        {% endif %}

        <div class="team-marquee">

            <div class="team-track {% if team|length > 3  %}scrolling{% endif %}">

                <div class="team-group">

                    {% for member in team %}

                        {% set media = member.media.first %}

                        <article class="team-card">

                            {# MODIFY MEMBER #}
                            <a
                                href="{{ path('app_edit_section', {
                                    'sectionType': 'team',
                                    'id': member.id
                                }) }}"
                                class="btn btn-primary edit-display"
                                title="Modifier la section"
                            >
                                ✎ Edit member
                            </a>

                            <div class="team-card-image">
                                {% if media %}
                                    <img
                                        src="{{ asset(media.path ~ media.filename) }}"
                                        alt="{{ member.firstname }} {{ member.lastname }}"
                                    >
                                {% endif %}
                            </div>

                            <div class="team-card-info">

                                {% if member.role %}
                                    <span class="team-card-role">{{ member.role }}</span>
                                {% endif %}

                                <h3>
                                    {{ member.firstname }} {{ member.lastname }}
                                </h3>

                                {% if member.bio %}
                                    <button
                                        class="team-bio-open"
                                        type="button"
                                        data-member-modal="team-bio-{{ member.id }}"
                                        aria-haspopup="dialog"
                                    >Read bio</button>
                                {% endif %}

                            </div>

                        </article>

                    {% endfor %}

                </div>

                {# COPIE POUR LE SCROLL #}
                {% if team|length > 3 %}

                    <div class="team-group" aria-hidden="true">

                        {% for member in team %}

                            {% set media = member.media.first %}

                            <article class="team-card">

                                <div class="team-card-image">
                                    {% if media %}
                                        <img
                                            src="{{ asset(media.path ~ media.filename) }}"
                                            alt=""
                                        >
                                    {% endif %}
                                </div>

                                <div class="team-card-info">
                                    {% if member.role %}
                                        <span class="team-card-role">{{ member.role }}</span>
                                    {% endif %}

                                    <h3>
                                        {{ member.firstname }} {{ member.lastname }}
                                    </h3>

                                </div>

                            </article>

                        {% endfor %}

                    </div>

                {% endif %}

            </div>

        </div>
    {% else %}

        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle">

                <thead>
                <tr>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>Bio</th>
                    <th class="text-end">Action</th>
                </tr>
                </thead>

                <tbody>

                {% for member in team %}

                    <tr>
                        <td>{{ member.lastname }}</td>
                        <td>{{ member.firstname }}</td>
                        <td>
                            {{ member.bio|raw }}
                        </td>
                        <td class="text-end">
                            <a
                                href="{{ path('app_edit_section', {
                                    'sectionType': 'team',
                                    'id': member.id
                                }) }}"
                                class="btn btn-primary btn-sm"
                            >
                                ✎ Edit
                            </a>
                            <a
                                href="{{ path('app_remove_member', {
                                    'id': member.id
                                }) }}"
                                class="btn btn-primary btn-sm"
                            >
                                ✎ Delete
                            </a>
                        </td>

                    </tr>

                {% endfor %}

                </tbody>

            </table>
        </div>

    {% endif %}

</section>

{% if section is not null and team|length > 0 and not editing %}
    {% for member in team %}
        {% set media = member.media.first %}
        <dialog class="team-bio-modal" id="team-bio-{{ member.id }}" aria-labelledby="team-bio-title-{{ member.id }}">
            <div class="team-bio-modal__layout">
                {% if media %}
                    <div class="team-bio-modal__image">
                        <img src="{{ asset(media.path ~ media.filename) }}" alt="{{ member.firstname }} {{ member.lastname }}">
                    </div>
                {% endif %}
                <div class="team-bio-modal__body">
                    <button class="team-bio-modal__close" type="button" data-close-member-modal aria-label="Close dialog">×</button>
                    {% if member.role %}
                        <p class="team-bio-modal__role">{{ member.role }}</p>
                    {% endif %}
                    <h2 id="team-bio-title-{{ member.id }}">{{ member.firstname }} {{ member.lastname }}</h2>
                    <div class="team-bio-modal__text">{{ member.bio|raw }}</div>
                </div>
            </div>
        </dialog>
    {% endfor %}
{% endif %}

<script>
    (() => {
        if (document.documentElement.dataset.teamBioDialogsBound) {
            return;
        }
        document.documentElement.dataset.teamBioDialogsBound = 'true';

        document.addEventListener('click', (event) => {
            const openButton = event.target.closest('[data-member-modal]');
            if (openButton) {
                document.getElementById(openButton.dataset.memberModal)?.showModal();
                return;
            }

            const closeButton = event.target.closest('[data-close-member-modal]');
            if (closeButton) {
                closeButton.closest('dialog')?.close();
                return;
            }

            if (event.target instanceof HTMLDialogElement && event.target.classList.contains('team-bio-modal')) {
                event.target.close();
            }
        });
    })();
</script>
