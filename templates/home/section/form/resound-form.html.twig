<turbo-stream action="replace" target="{{ spot }}">
    <template>
        <section id="{{ spot }}" class="container py-5">
            <div class="row justify-content-center">
                <div class="col-12 col-xl-9">
                    <div class="section-edit-card">
                        <header class="section-edit-heading">
                            <p class="section-edit-kicker">// RESOUND //</p>
                            <h2>{{ resound is defined and resound.id ? 'Edit resound' : 'Add resound' }}</h2>
                            <p>Give this sound piece a title and upload its video.</p>
                        </header>

                        {{ form_start(form, {
                            action: path('app_edit_section', { sectionType: spot }),
                            attr: { 'data-turbo': 'true', class: 'section-edit-form' }
                        }) }}
                            <div class="section-edit-fields">
                                {{ form_row(form.title) }}
                                {% if resound is defined and resound.media %}
                                    {% set currentMedia = resound.media %}
                                    <div class="section-edit-preview">
                                        <video controls playsinline preload="metadata">
                                            <source src="{{ asset(currentMedia.path ~ currentMedia.filename) }}" type="{{ currentMedia.mimeType|default('video/mp4') }}">
                                        </video>
                                        <p>{{ currentMedia.filename }}</p>
                                    </div>
                                {% endif %}
                                {{ form_row(form.media) }}
                            </div>
                            <div class="section-edit-actions">
                                <button type="submit" name="_cancel" value="1" class="btn btn-outline-light">Cancel</button>
                                <button type="submit" class="btn btn-primary">Save resound <span aria-hidden="true">↗</span></button>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>

        </section>
    </template>
</turbo-stream>
