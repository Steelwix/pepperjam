<turbo-stream action="replace" target="{{ spot }}">
    <template>
        <section id="{{ spot }}" class="container py-5">

            {{ form_start(form, {
                action: path('app_edit_section', {
                    sectionType: spot
                }),
                attr: {
                    'data-turbo': 'true'
                }
            }) }}

            {{ form_row(form.title) }}

            {% if resound is defined and resound.media %}
                {% set currentMedia = resound.media %}

                <video controls preload="metadata" style="max-width: 600px; width: 100%;">
                    <source
                        src="{{ asset(currentMedia.path ~ currentMedia.filename) }}"
                        type="{{ currentMedia.mimeType|default('video/mp4') }}"
                    >
                </video>
            {% endif %}

            {{ form_row(form.media) }}

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    Submit
                </button>
            </div>

            {{ form_end(form) }}

        </section>
    </template>
</turbo-stream>
