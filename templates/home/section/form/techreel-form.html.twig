<turbo-stream action="replace" target="{{ spot }}">
    <template>
                    <section id="{{ spot }}" class="container py-5 techreel-edit-form">
            <div class="row justify-content-center">
                <div class="col-12 col-xl-9">
                    <div class="section-edit-card">
                        <header class="section-edit-heading">
                            <p class="section-edit-kicker">// TECHREEL //</p>
                            <h2>Update the techreel</h2>
                            <p>Choose the video that shows how the studio works.</p>
                        </header>

                        {{ form_start(form, {
                            action: path('app_edit_section', { sectionType: spot }),
                            attr: { 'data-turbo': 'true' }
                        }) }}
                            <div class="section-edit-fields">
                                {{ form_row(form.media) }}
                            </div>
                            <div class="section-edit-preview">
                                {% if media %}
                                    <video controls playsinline preload="metadata">
                                        <source src="{{ asset(media.path ~ media.filename) }}" type="{{ media.mimeType|default('video/mp4') }}">
                                    </video>
                                    <p>{{ media.filename }}</p>
                                {% else %}
                                    <p>No video uploaded yet.</p>
                                {% endif %}
                            </div>
                            <div class="section-edit-actions">
                                <button type="submit" name="_cancel" value="1" class="btn btn-outline-light">Cancel</button>
                                <button type="submit" class="btn btn-primary">Save video <span aria-hidden="true">↗</span></button>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </section>
    </template>
</turbo-stream>
