{% extends 'base.html.twig' %}

{% block body %}
    <section id="projects" class="container py-4">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>{{ activity.title }} — Projets</h1>

                <a href="{{ path('app_activity_project_create') }}"
                   class="btn btn-primary edit-display">
                    ✎ Ajouter un projet
                </a>
        </div>

        {% if editing is defined and editing is true %}
            <table class="table">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre de médias</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for project in activity.projects %}
                    <tr>
                        <td>{{ project.id }}</td>
                        <td>{{ project.media|length }}</td>
                        <td>
                            <a href="{{ path('app_activity_project_edit', { id: project.id }) }}"
                               class="btn btn-primary btn-sm">
                                ✎ Modifier
                            </a>

                            <form method="post"
                                  action="{{ path('app_activity_project_delete', { id: project.id }) }}"
                                  class="d-inline"
                                  onsubmit="return confirm('Supprimer ce projet ?');">
                                <input type="hidden" name="_token"
                                       value="{{ csrf_token('delete-project-' ~ project.id) }}">
                                <button class="btn btn-danger btn-sm">
                                    Supprimer
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3">Aucun projet.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

        {% else %}
            <div class="row g-3">
                {% for project in activity.projects %}
                    {% set media = project.media|first %}

                    <div class="col-12 col-md-4">
                        <a href="#"
                           class="d-block project-card">

                            {% if media %}
                                <img src="{{ asset(media.path ~ media.filename) }}"
                                     alt=""
                                     class="img-fluid w-100">
                            {% endif %}

                            <div class="p-2">
                                Projet {{ project.id }}
                            </div>
                        </a>
                    </div>
                {% else %}
                    <div class="col-12">
                        Aucun projet pour cette activité.
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </section>
{% endblock %}
