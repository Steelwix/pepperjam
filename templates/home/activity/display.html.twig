{% extends 'base.html.twig' %}

{% block title %}{{ activity.title }} — Pepperjam{% endblock %}

{% block body %}
    <main class="activity-page">
        <div class="activity-page__shell">
            <nav class="activity-switcher" aria-label="Activity navigation">
                <a class="activity-switcher__home" href="{{ path('app_home') }}" aria-label="Back to home">
                    <span aria-hidden="true">←</span>
                    <span>Home</span>
                </a>

                <span class="activity-switcher__divider" aria-hidden="true"></span>

                <div class="activity-switcher__list">
                    {% for item in activities %}
                        <a
                            href="{{ path('app_activity_view', { id: item.id, editing: editing ? 'true' : 'false' }) }}"
                            class="activity-switcher__link {{ item.id == activity.id ? 'is-active' : '' }}"
                            {% if item.id == activity.id %}aria-current="page"{% endif %}
                        >
                            {{ item.title }}
                        </a>
                    {% endfor %}
                </div>
            </nav>

            <header class="activity-hero">
                <div>
                    <p class="activity-hero__eyebrow">Projects <span> / </span> {{ activity.projects|length }}</p>
                    <h1>{{ activity.title }}</h1>
                </div>

                {% if editing %}
                    <a href="{{ path('app_activity_project_create') }}" class="activity-add-project">
                        <span aria-hidden="true">＋</span> Add project
                    </a>
                {% endif %}
            </header>

            {% if activity.projects|length > 0 %}
                <section class="project-grid" aria-label="Projects">
                    {% for project in activity.projects %}
                        {% set media = project.media|first %}
                        <article class="project-tile">
                            <div class="project-tile__visual">
                                {% if media and media.mimeType starts with 'image/' %}
                                    <img src="{{ asset(media.path ~ media.filename) }}" alt="{{ activity.title }} project {{ loop.index }}" loading="lazy">
                                {% elseif media and media.mimeType starts with 'video/' %}
                                    <video controls playsinline preload="metadata" aria-label="{{ activity.title }} project {{ loop.index }}">
                                        <source src="{{ asset(media.path ~ media.filename) }}" type="{{ media.mimeType }}">
                                    </video>
                                {% else %}
                                    <div class="project-tile__empty">No preview</div>
                                {% endif %}
                                <span class="project-tile__index">{{ '%02d'|format(loop.index) }}</span>
                            </div>

                            {% if editing %}
                                <div class="project-tile__actions">
                                    <a href="{{ path('app_activity_project_edit', { id: project.id }) }}">Edit</a>
                                    <form method="post" action="{{ path('app_activity_project_delete', { id: project.id }) }}" onsubmit="return confirm('Delete this project?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-project-' ~ project.id) }}">
                                        <button type="submit">Delete</button>
                                    </form>
                                </div>
                            {% endif %}
                        </article>
                    {% endfor %}
                </section>
            {% else %}
                <div class="activity-empty">
                    <span>Nothing here yet.</span>
                    {% if editing %}
                        <a href="{{ path('app_activity_project_create') }}">Add the first project <span aria-hidden="true">↗</span></a>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </main>
{% endblock %}
